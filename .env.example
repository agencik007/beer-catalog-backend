NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/beer_catalog
# Set to true on a replica set / MongoDB Atlas to run auth writes in transactions
MONGO_TRANSACTIONS=false

# Comma-separated list of allowed frontend origins (CORS + Better Auth trustedOrigins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=changeme_at_least_32_characters_long_secret
# Public URL of this backend (used for email links and OAuth callbacks)
BETTER_AUTH_URL=http://localhost:5000

# Email (Brevo). Without BREVO_API_KEY, links are logged to the console in development.
# API key: Brevo -> SMTP & API -> API Keys. Sender address must be verified in Brevo -> Senders, Domains & Dedicated IPs.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Beer Catalog

# OAuth (optional). Callback URLs: ${BETTER_AUTH_URL}/api/auth/callback/google and /github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
