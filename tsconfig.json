{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "CommonJS",
		"moduleResolution": "Node",
		"rootDir": ".",
		"outDir": "dist",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"downlevelIteration": true,
		"preserveConstEnums": true,
		"strict": true,
		"noImplicitAny": true
	},
	"typeRoots": ["./types", "./node_modules/@types"],
	"exclude": ["node_modules"]
}
