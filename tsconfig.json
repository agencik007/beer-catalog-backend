{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": ".",
		"outDir": "dist",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"preserveConstEnums": true,
		"strict": true,
		"noImplicitAny": true,
		"types": ["node"]
	},
	"typeRoots": ["./types", "./node_modules/@types"],
	"exclude": ["node_modules"]
}
